<%- include("./partials/header") %>

<div class="cartbkg" style="min-height: 100vh; padding-top: 80px;">
    <div class="container">
        <% if(products && products.length > 0) { %>
            <h1 style="text-align: center; color: #fff; font-family: 'Playfair Display', serif; margin-bottom: 40px;">Your Cart</h1>
            
            <div class="row">
                <div class="col-md-8 col-md-offset-2">
                    <% products.forEach((product) => { %>
                        <div class="list-group-item" style="background: rgba(255,255,255,0.95); border: none; border-radius: 10px; margin-bottom: 15px; padding: 20px; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 5px 15px rgba(0,0,0,0.1);">
                            <div>
                                <h3 style="margin: 0; color: #1a1a1a; font-family: 'Poppins', sans-serif;"><%= product.item.name %></h3>
                                <p style="margin: 5px 0 0 0; color: #666;">Qty: <%= product.qty %></p>
                            </div>
                            <div style="display: flex; align-items: center; gap: 15px;">
                                <h3 style="margin: 0; color: #c9a227; font-weight: 600;"><i class="fas fa-rupee-sign"></i><%= product.price %></h3>
                                <div>
                                    <a href="/reduce/<%= product.item._id %>" class="btn btn-danger" style="background: #e74c3c; border: none; padding: 8px 15px; border-radius: 20px; font-size: 12px;">-1</a>
                                    <a href="/remove/<%= product.item._id %>" class="btn btn-danger" style="background: #c0392b; border: none; padding: 8px 15px; border-radius: 20px; font-size: 12px;">Remove</a>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
            
            <div class="row">
                <div class="col-md-4 col-md-offset-4" style="text-align: center;">
                    <h2 style="color: #fff; font-family: 'Playfair Display', serif;">Total: <span style="color: #c9a227;"><i class="fas fa-rupee-sign"></i><%= totalPrice %></span></h2>
                </div>
            </div>
            
            <div class="row" style="text-align: center; margin-top: 30px;">
                <div class="col-md-4 col-md-offset-4">
                    <a href="/checkout" class="btn btn-success" style="background: #c9a227; border: none; padding: 15px 50px; border-radius: 50px; font-size: 16px; font-weight: 600; text-transform: uppercase; letter-spacing: 2px; color: #1a1a1a;">Proceed to Checkout</a>
                </div>
            </div>
        <% } else { %>
            <div style="text-align: center; padding: 100px 0;">
                <i class="fas fa-shopping-cart" style="font-size: 80px; color: rgba(255,255,255,0.3); margin-bottom: 30px;"></i>
                <h2 style="color: #fff; font-family: 'Playfair Display', serif;">Your Cart is Empty</h2>
                <p style="color: rgba(255,255,255,0.7); margin-bottom: 30px;">Add some delicious items from our menu!</p>
                <a href="/menu" class="bt" style="background: #c9a227; color: #1a1a1a;">Browse Menu</a>
            </div>
        <% } %>
    </div>
</div>

<%- include("./partials/footer") %>
