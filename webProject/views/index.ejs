<%- include("./partials/header2") %>

<header id="home">
    <div class="indexhead">
        <div class="landing-text">
            <h1>The Imperial Spice</h1>
            <p>Authentic Indian Cuisine</p>
            <span class="tagline">Taste the Royal Delight</span>
            <div style="margin-top: 40px;">
                <a href="/booking" class="bt">Book a Table</a>
                <a href="/menu" class="bt bt-outline">Order Now</a>
            </div>
        </div>
    </div>
</header>

<section id="about" class="our_story">
    <div class="container">
        <div class="row">
            <div class="col-lg-6 col-md-6 col-sm-12">
                <img src="https://images.unsplash.com/photo-1555396273-367ea4eb4db5?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80" alt="Restaurant Interior" class="img-responsive">
            </div>
            <div class="col-lg-6 col-md-6 col-sm-12" style="display: flex; flex-direction: column; justify-content: center;">
                <div style="text-align: center;">
                    <h1>Our Story</h1>
                    <hr style="width: 60px; height: 3px; background: #c9a227; margin: 20px auto;">
                </div>
                <p class="lead">Welcome to The Imperial Spice, where we bring you the finest authentic Indian cuisine. Our philosophy is simple - provide great food, exceptional value, and friendly service to each and every customer we serve.</p>
                <p class="lead">For over 7 years we have been serving the finest dishes from the royal kitchens of India. Our recipes have been passed down through generations, ensuring an authentic taste that keeps our guests coming back for more.</p>
                <p class="lead">Experience the rich flavors and aromatic spices that make Indian cuisine world-renowned. Every dish is prepared with fresh ingredients and authentic spices to give you an unforgettable dining experience.</p>
            </div>
        </div>
    </div>
</section>

<section class="book text-center">
    <div class="container">
        <h1>Reserve Your Table</h1>
        <p>Experience the royal treatment at The Imperial Spice</p>
        <a href="/booking" class="bt">Book Now</a>
    </div>
</section>

<section class="chef">
    <div class="container">
        <div class="row">
            <div class="col-lg-6 col-md-6 col-sm-12" style="display: flex; flex-direction: column; justify-content: center;">
                <div style="text-align: center;">
                    <h1>Chef's Message</h1>
                    <hr style="width: 60px; height: 3px; background: #c9a227; margin: 20px auto;">
                </div>
                <p class="lead">At The Imperial Spice, we believe that food is not just sustenance but an art form. Our chef meticulously selects the finest ingredients to create dishes that tantalize your taste buds and leave you craving for more.</p>
                <p class="lead">We aim to home-produce as much as possible to ensure the highest quality and authenticity. Every dish that leaves our kitchen is a testament to our commitment to excellence and our passion for Indian cuisine.</p>
                <p class="lead">We invite you to experience the authentic taste of India, prepared with love and served with warmth.</p>
            </div>
            <div class="col-lg-6 col-md-6 col-sm-12">
                <img src="https://images.unsplash.com/photo-1577219491135-ce391730fb2c?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80" alt="Chef" class="img-responsive">
            </div>
        </div>
    </div>
</section>

<%- include("./partials/footer") %>
