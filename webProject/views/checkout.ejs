<%- include("./partials/header") %>

<div id="checkout" style="min-height: 100vh; padding-top: 80px;">
    <div class="container">
        <div class="row">
            <div class="col-md-6 col-md-offset-3">
                <div style="background: rgba(255,255,255,0.95); padding: 40px; border-radius: 15px; box-shadow: 0 10px 30px rgba(0,0,0,0.3);">
                    <h1 style="text-align: center; font-family: 'Playfair Display', serif; color: #1a1a1a; margin-bottom: 10px;">Checkout</h1>
                    <hr style="border-color: #c9a227; margin-bottom: 30px;">
                    
                    <% if(errMsg) { %>
                        <div class="alert alert-danger"><%= errMsg %></div>
                    <% } %>
                    
                    <form action="/checkout" method="post" id="checkout-form">
                        <div class="form-group">
                            <label style="color: #333; font-weight: 600;">Full Name</label>
                            <input type="text" id="name" name="name" class="form-control" style="border: 2px solid #ddd; border-radius: 8px; padding: 12px;" required>
                        </div>
                        
                        <div class="form-group">
                            <label style="color: #333; font-weight: 600;">Delivery Address</label>
                            <textarea id="address" name="address" class="form-control" rows="3" style="border: 2px solid #ddd; border-radius: 8px; padding: 12px;" required></textarea>
                        </div>
                        
                        <div class="form-group">
                            <label style="color: #333; font-weight: 600;">Phone Number</label>
                            <input type="tel" id="phone" name="phone" class="form-control" style="border: 2px solid #ddd; border-radius: 8px; padding: 12px;" required>
                        </div>
                        
                        <div class="form-group">
                            <label style="color: #333; font-weight: 600;">Payment Method</label>
                            <div style="background: #f8f9fa; padding: 15px; border-radius: 8px; margin-bottom: 20px;">
                                <label style="color: #28a745; font-weight: 600; cursor: pointer;">
                                    <input type="radio" name="payment" value="cod" checked> 
                                    <i class="fas fa-money-bill-wave"></i> Cash on Delivery
                                </label>
                            </div>
                        </div>
                        
                        <div style="background: #fff3cd; padding: 20px; border-radius: 8px; margin-bottom: 25px; text-align: center;">
                            <h4 style="margin: 0; color: #856404;">Order Total: <span style="color: #c9a227; font-size: 24px; font-weight: 700;"><i class="fas fa-rupee-sign"></i><%= total %></span></h4>
                        </div>
                        
                        <button type="submit" class="btn btn-success btn-block" style="background: #c9a227; border: none; padding: 15px; border-radius: 50px; font-size: 16px; font-weight: 600; text-transform: uppercase; letter-spacing: 2px; color: #1a1a1a;">
                            <i class="fas fa-check-circle"></i> Place Order
                        </button>
                        
                        <div style="text-align: center; margin-top: 20px;">
                            <a href="/cart" style="color: #666; text-decoration: none;">&larr; Back to Cart</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include("./partials/footer") %>
