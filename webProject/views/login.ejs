<%- include("./partials/header1") %>

<div class="reg-log">
    <div class="container">
        <form class="form" action="/users/login" method="post" name="form" onsubmit="return validated()">
            <h1>Welcome Back</h1>
            <h5>Username</h5>
            <input class="form-control" type="text" name="username" placeholder="Enter your username" required>
            <h5>Password</h5>
            <input class="form-control" type="password" name="password" placeholder="Enter your password" required>
            <input class="btn btn-primary" type="submit" value="Login">
            <p>Don't have an account? <a href="/users/register">Create one!</a></p>
        </form>
    </div>
</div>

<%- include("./partials/footer1") %>
