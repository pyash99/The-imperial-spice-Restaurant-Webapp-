<%- include("./partials/header1") %>

<div class="reg-log">
    <div class="container">
        <form class="form" action="/users/register" method="post" name="form" onsubmit="return validated()">
            <h1>Create Account</h1>
            
            <h5>Full Name</h5>
            <input class="form-control" type="text" name="name" placeholder="Enter your full name" required>
            
            <h5>Email Address</h5>
            <input class="form-control" type="email" name="email" placeholder="Enter your email" required>
            
            <h5>Username</h5>
            <input class="form-control" type="text" name="username" placeholder="Choose a username" required>
            
            <h5>Password</h5>
            <input class="form-control" type="password" name="password" placeholder="Create a password" required>
            
            <h5>Confirm Password</h5>
            <input class="form-control" type="password" name="password2" placeholder="Confirm your password" required>
            
            <input class="btn btn-primary" type="submit" value="Register">
            <p>Already have an account? <a href="/users/login">Login here</a></p>
        </form>
    </div>
</div>

<%- include("./partials/footer1") %>
